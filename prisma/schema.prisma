// EcoFlow / GreenEco CRM — core schema (Master Build Spec §5).
// Every model: companyId (tenant-ready), timestamps, audit via AuditLog.
// Postgres 16+ required: @db.Decimal money + String[] scalar lists.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}


enum LeadStatus {
  NEW
  IN_FOLLOWUP
  QUOTE_REQUESTED
  CONVERTED
  LOST
  ON_HOLD
}

enum FollowUpType {
  CALL
  SITE_VISIT
  WHATSAPP
  EMAIL
  MEETING
}

enum FollowUpOutcome {
  INTERESTED
  NEEDS_TIME
  PRICE_DISCUSSION
  NOT_REACHABLE
  NEGATIVE
}

enum ProposalStatus {
  DRAFT
  SENT
  UNDER_NEGOTIATION
  WON
  LOST
  EXPIRED
}

/**
 * PENDING   — raised by an employee, waiting on the office.
 * ACCEPTED  — admin has taken it on but hasn't produced the proposal yet.
 * REJECTED  — admin declined it (rejectionReason required).
 * FULFILLED — the proposal exists; `proposalId` points at it.
 */
enum ProposalRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  FULFILLED
}

enum OrderStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum DrawingStatus {
  DRAFT
  FOR_APPROVAL
  APPROVED
  SUPERSEDED
}

enum MilestoneStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
}

enum POStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
}

enum LocationType {
  WAREHOUSE
  SITE
}

enum MovementType {
  GRN
  TRANSFER_OUT
  TRANSFER_IN
  CONSUME
  ADJUST
  RETURN
}

enum ErectionType {
  LABOUR
  SITE_PURCHASE
  OTHER
}

enum EntryStatus {
  PENDING
  APPROVED
  QUERIED
  REJECTED
}

model User {
  id           String   @id // Clerk userId (or dev-shim id)
  companyId    String
  name         String
  phone        String
  email        String?  @unique // credentials-login identity
  passwordHash String? // scrypt hash (credentials login)
  avatarUrl    String? // profile photo, via the same storage adapter as other uploads
  jobTitle     String? // display-only org-chart label (free text — admin can add new ones); NEVER read for authorization
  role         Role     @default(EMPLOYEE)
  /**
   * Per-user capability grants — the first authorization signal in this app that is
   * NOT derived from `role` alone.
   *
   * Until now an admin could only widen an employee's access by promoting them to full
   * ADMIN, which hands over pricing, margins, budgets, POs, vendor prices, receipts,
   * invoices, user management and settings all at once. A capability grants exactly one
   * thing instead. Admins implicitly hold every capability — this array is only ever
   * consulted for non-admins (see hasCapability in lib/rbac.ts).
   *
   * Values come from the CAPABILITIES allowlist in lib/rbac.ts. Unknown strings are
   * inert, so a removed capability degrades to "not granted" rather than crashing.
   * Deliberately NOT a relation table: the repo's convention is bare id strings with no
   * Prisma relation to User, and a String[] keeps the grant readable in one row.
   */
  capabilities String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([companyId])
}

model Lead {
  id           String     @id @default(cuid())
  companyId    String
  customerName    String
  address         String
  projectName     String?
  projectAddress  String?
  lat             Float?
  lng             Float?
  phone           String // duplicate-check key
  email        String?
  source       String // Reference | SiteVisit | CallIn | Builder | Consultant | Other
  requirement  String? // free-text notes (structured sizing lives in the fields below)
  status       LeadStatus @default(NEW)
  lostReason   String?
  assignedToId String
  referenceId  String?

  // Institutional/B2B lead capture — additive, all nullable so pre-existing leads are
  // unaffected. Deliberately separate from `source` (kept as-is — it already drives
  // by-source analytics/filters/exports): `leadType` is WHAT the lead is (their trade),
  // `howMet` is HOW we first made contact. See lib/constants.ts LEAD_TYPES/HOW_MET_OPTIONS.
  leadType String? // Builder/Developers | Architects | Consultant-MEP | Consultant-PMC | Government Sector | Others
  howMet   String? // Referred by | They call us | We visit office | We visit site | Other
  state    String? // Indian state/UT name — see lib/constants.ts INDIAN_STATES
  branchOffices Json? // [{address, phone, email}] — additional branch-office locations

  // Structured plant-sizing (spec §7.1) — captured at the lead stage so the
  // pipeline can be filtered/analyzed by KLD and a BOQ band previewed pre-quote.
  // All nullable: pre-P2 leads have none; convertToProposal coalesces defaults.
  plantType        String? // STP | ETP | WTP | Softener | UF | RO | UV | HNS System | OWC | SWM | Others
  technology       String? // MBBR | SBR | MBR | ASP | SAFF
  capacityKLD      Float? //  central sizing dimension (kilolitres/day) — always KLD-denominated, derived when capacityUnit != "KLD"
  capacityValue    Float? // raw entered value in capacityUnit — kept alongside capacityKLD purely so the form can redisplay what was actually typed
  capacityUnit     String? // KLD | LPH | Kg/Day | Tons/Day — see lib/constants.ts CAPACITY_UNITS
  segment          String? // Apartment | Textile | Hospital | Hotel | ITPark | Industrial | Municipal | Institution
  budgetBand       String? // indicative budget band
  decisionTimeline String? // expected decision timeframe
  // Inlet water quality — needed to size a plant (mg/l except flow).
  inletBOD Float?
  inletCOD Float?
  inletTSS Float?
  inletTDS Float?

  reference      Reference?      @relation(fields: [referenceId], references: [id])
  contacts       ContactPerson[]
  followUps      FollowUp[]
  communications Communication[]
  documents      LeadDocument[]
  // One enquiry can carry several proposals — one per proposal TYPE (a Project
  // Proposal *and* a BOQ *and* an AMC proposal for the same site). This was 1:1
  // (`proposal Proposal?` + `leadId @unique`) until the proposal-type work; a
  // *revision* is still a new ProposalVersion, never a second Proposal row.
  proposals        Proposal[]
  proposalRequests ProposalRequest[]
  drawingRequests  DrawingRequest[]
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([companyId, status])
  @@index([phone])
}

/**
 * Communication log (spec §7.1) — calls / WhatsApp / email against a lead, both
 * outbound (logged or app-sent) and inbound (webhook). Distinct from FollowUp
 * (which schedules a next action); a Communication is a record of a touch.
 */
model Communication {
  id          String   @id @default(cuid())
  companyId   String
  leadId      String? // set for lead comms
  proposalId  String? // set for proposal comms (send-to-client tracking)
  orderId     String? // set for project comms (execution client-comms)
  contractId  String? // set for AMC/service client-comms
  channel     String // CALL | WHATSAPP | EMAIL
  direction   String // OUT | IN
  body        String
  toAddress   String? // phone or email the message went to / came from
  subject     String? // email subject
  sentStatus  String? // SENT | FAILED | LOGGED | RECEIVED
  createdById String
  createdAt   DateTime @default(now())

  lead     Lead?            @relation(fields: [leadId], references: [id])
  proposal Proposal?        @relation(fields: [proposalId], references: [id])
  order    Order?           @relation(fields: [orderId], references: [id])
  contract ServiceContract? @relation(fields: [contractId], references: [id])

  @@index([leadId])
  @@index([proposalId])
  @@index([orderId])
  @@index([contractId])
  @@index([companyId, channel])
}

/** Documents attached to a proposal — signed copy, client PO, revised drawings, tender docs. */
model ProposalDocument {
  id          String   @id @default(cuid())
  companyId   String
  proposalId  String
  url         String
  name        String
  createdById String
  createdAt   DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id])

  @@index([proposalId])
}

/** Documents attached to a lead — site photos, water-test reports, tender/RFQ PDFs, drawings. */
model LeadDocument {
  id          String   @id @default(cuid())
  companyId   String
  leadId      String
  url         String
  name        String
  createdById String
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

model ContactPerson {
  id          String  @id @default(cuid())
  leadId      String?
  clientId    String?
  name        String
  designation String? // Manager, Association Secretary, etc.
  mobile      String
  email       String?
  location    String? // where this person is normally available (site/office/branch)

  lead      Lead?      @relation(fields: [leadId], references: [id])
  client    Client?    @relation(fields: [clientId], references: [id])
  proposals Proposal[] // "Kind Attn" back-relation
}

/**
 * A real client identity, distinct from Lead (an enquiry) — created the moment a
 * proposal is marked Won (see markWon), found by exact customerName match within
 * the company so a repeat customer's new project attaches to their existing Client
 * row instead of creating a duplicate (same identity key listClientCustomers
 * already groups leads by, kept consistent on purpose). Backfilled once for
 * pre-existing Won orders via scripts/backfill-clients.ts.
 */
model Client {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  address   String?
  state     String?
  gstin     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  contacts ContactPerson[]

  @@index([companyId, name])
}

model Reference {
  id        String  @id @default(cuid())
  companyId String
  name      String
  address   String?
  phone     String?
  email     String?
  leads     Lead[] // powers reference analytics
}

model FollowUp {
  id            String           @id @default(cuid())
  leadId        String?
  proposalId    String? // same engine reused post-quote
  datetime      DateTime         @default(now())
  type          FollowUpType
  notes         String // cleaned text (editable)
  rawTranscript String?
  audioUrl      String? // purge after 90 days (cron)
  lat           Float?
  lng           Float?
  geoAddress    String? // reverse-geocoded
  outcome       FollowUpOutcome?
  nextDate      DateTime? // MANDATORY unless lead is being closed
  completedAt   DateTime? // set when user marks this follow-up done
  attachments   Json? // [{url, name}]
  createdById   String
  createdAt     DateTime         @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id])
  proposal Proposal? @relation(fields: [proposalId], references: [id])

  @@index([leadId])
  @@index([proposalId])
  @@index([nextDate])
}

model Proposal {
  id             String            @id @default(cuid())
  companyId      String
  number         String            @unique // GEC-PRO-2026-001 — allocated at creation, revealed in the UI once complete
  // NOT unique — a lead may have one proposal per type. The dropped @unique was
  // also the only index serving `where: { leadId }`, hence the explicit @@index below.
  leadId         String
  projectName    String
  siteAddress    String
  plantType      String // STP | ETP | WTP | Softener | UF | RO | UV | HNS System | OWC | SWM | Others
  technology     String // MBBR | SBR | MBR | ASP | ...
  capacityKLD    Float // always KLD-denominated — derived from capacityValue/capacityUnit when unit != "KLD"
  capacityValue  Float? // raw entered value in capacityUnit — kept alongside capacityKLD purely so the editor can redisplay what was actually typed
  capacityUnit   String @default("KLD") // KLD | LPH | Kg/Day | Tons/Day
  status         ProposalStatus    @default(DRAFT)
  lostReason     String? // required on LOST — feeds AI learning loop
  currentVersion Int               @default(1)
  contactPersonId  String? // "Kind Attn" — must belong to this proposal's own lead (checked in code; ContactPerson has no companyId)
  proposalType     String? // Project Proposal | BOQ Proposal | AMC Proposal | Service Proposal | Others — capture-only, doesn't branch Won→Order yet
  projectCategory  String? // Residential | Commercial | Industrial | Hospital | Academicals | Others
  versions       ProposalVersion[]
  followUps      FollowUp[]
  communications Communication[]
  documents      ProposalDocument[]
  requests       ProposalRequest[]
  order          Order?
  createdById    String
  createdAt      DateTime          @default(now())

  lead           Lead           @relation(fields: [leadId], references: [id])
  contactPerson  ContactPerson? @relation(fields: [contactPersonId], references: [id])

  @@index([companyId, status])
  @@index([leadId])
}

/**
 * An employee's request to the office for a proposal (spec: field staff capture the
 * enquiry, the admin writes the document). The employee-facing half deliberately
 * carries NO pricing at all — same shape as MaterialRequest, the repo's other
 * employee→admin request flow.
 *
 * `proposalType` picks which document format the admin will produce; `technology`
 * only applies to a Project Proposal (MBBR|SBR|ASP|MBR), which is the only type
 * with per-technology document variants.
 */
model ProposalRequest {
  id              String                @id @default(cuid())
  companyId       String
  leadId          String
  proposalType    String // see lib/constants.ts PROPOSAL_TYPES
  technology      String? // MBBR | SBR | ASP | MBR — Project Proposal only
  plantType       String? // STP | ETP | WTP | ...
  capacityValue   Float?
  capacityUnit    String                @default("KLD")
  notes           String? // what the customer actually asked for
  status          ProposalRequestStatus @default(PENDING)
  rejectionReason String?
  proposalId      String? // set once the admin creates the proposal from this request
  requestedById   String
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime              @default(now())

  lead     Lead      @relation(fields: [leadId], references: [id])
  proposal Proposal? @relation(fields: [proposalId], references: [id])

  @@index([companyId, status])
  @@index([leadId])
  @@index([companyId, requestedById])
}

model ProposalVersion {
  id            String    @id @default(cuid())
  proposalId    String
  versionNo     Int
  scopeOfWork   Json // {civil, mechanical, electrical, commissioning, exclusions}
  technicalText String // AI-generated write-up (marked until reviewed)
  boqItems      BOQItem[]
  subtotal      Decimal   @db.Decimal(14, 2)
  gstAmount     Decimal   @db.Decimal(14, 2)
  grandTotal    Decimal   @db.Decimal(14, 2)
  estimatedCost Decimal?  @db.Decimal(14, 2) // ADMIN-ONLY — margin guard
  paymentTerms  Json // [{description, percent, trigger}]
  terms         Json // standard T&Cs text — seeded from Company.standardTermsTemplate, editable per proposal
  validityDays  Int       @default(30)
  changeNote    String?
  approvedById  String? // admin approval before send
  pdfUrl        String?
  aiGenerated   Boolean   @default(false)
  createdAt     DateTime  @default(now())

  // Richer proposal document content (client corrections phase 2 — matches the
  // client's real proposal documents: cover letter, caveats, tech explainer,
  // component-level specs, electrical load). All nullable/optional — a pre-existing
  // proposal just renders without these sections until regenerated or edited in.
  coverLetter         String? // intro/greeting letter text
  pointsToNote        String? // caveats/callouts, one per line
  technologyExplainer String? // "how this technology works" — plant/technology specific
  technicalSpecs      Json? // [{section, item, spec, qty}] — component-level spec table
  /**
   * Electrical load summary. Row shape widened ADDITIVELY from `{description, hp}` to
   * `{description, hp, hpPerUnit?, units?, running?, standby?}` so the Project Report
   * can print the sample's full 7-column table (incl. standby units and the HP→kW
   * total) while every pre-existing row and consumer keeps working unchanged.
   */
  electricalLoad      Json?
  heroImageUrl        String? // AI-generated plant/process illustration (Gemini image model), shown in the PDF
  /**
   * Per-proposal-TYPE document fields — the numbers/parameters an admin actually
   * enters for this deal (capacity calculation, inlet/outlet parameters, and the
   * editable copies of the per-technology template blocks).
   *
   * ONE Json column with a per-type Zod schema rather than ~15 divergent nullable
   * columns: the four proposal types have genuinely heterogeneous field sets, which
   * is what Json is for. (Deliberate divergence from v29's richness fields, which
   * went the column route — those were shared by every proposal, these are not.)
   *
   * ⚠️ Must be merged (not overwritten) in saveVersion's versionData, or a partial
   * save blanks it — see the note on that function.
   */
  documentData        Json?

  proposal Proposal @relation(fields: [proposalId], references: [id])

  @@unique([proposalId, versionNo])
}

model BOQItem {
  id            String  @id @default(cuid())
  versionId     String
  category      String // Civil | Piping | PumpsBlowers | Media | Electrical | Others
  item          String
  specification String?
  unit          String
  qty           Decimal @db.Decimal(12, 3)
  rate          Decimal @db.Decimal(12, 2)
  amount        Decimal @db.Decimal(14, 2)
  aiSuggested   Boolean @default(false) // shows "review" badge until edited/confirmed

  version ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

model Order {
  id           String      @id @default(cuid())
  companyId    String
  orderNo      String      @unique // GEC-ORD-2026-001
  proposalId   String      @unique
  clientId     String? // linked on Won — see markWon; nullable only for pre-Client-model orders until backfilled
  clientName      String
  siteAddress     String
  clientStateCode String? // 2-digit GSTIN state prefix for place-of-supply (IGST vs CGST/SGST)
  clientGstin     String? // customer GSTIN for the B2B tax invoice
  clientPhone     String? // client WhatsApp for payment reminders (A4); backfilled from the lead
  projectValue    Decimal     @db.Decimal(14, 2)
  startDate    DateTime?
  targetDate   DateTime?
  status       OrderStatus @default(ACTIVE)

  team             TeamAssignment[]
  stages           Stage[]
  drawings         Drawing[]
  drawingRequests  DrawingRequest[]
  milestones       PaymentMilestone[]
  documents        Document[]
  communications   Communication[]
  erectionEntries  ErectionEntry[]
  budget           Budget?
  siteLocation     Location? // auto-created SITE location for stock
  materialRequests MaterialRequest[]
  serviceContracts ServiceContract[]
  createdAt        DateTime           @default(now())
  deletedAt        DateTime? // archive / soft-delete

  proposal Proposal @relation(fields: [proposalId], references: [id])
  client   Client?  @relation(fields: [clientId], references: [id])

  @@index([companyId, status])
}

model TeamAssignment {
  id      String @id @default(cuid())
  orderId String
  userId  String
  role    String // PROJECT_MANAGER | CIVIL_ENGINEER | SUPERVISOR

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, userId])
  @@index([userId])
}

model Stage {
  id          String       @id @default(cuid())
  orderId     String
  seq         Int
  name        String // from 9-stage default template (seed)
  plannedDate DateTime?
  actualDate  DateTime?
  status      StageStatus  @default(PENDING)
  delayReason String?
  notes       String?
  photos      StagePhoto[]

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model StagePhoto {
  id       String   @id @default(cuid())
  stageId  String
  url      String
  lat      Float?
  lng      Float?
  takenAt  DateTime @default(now())
  byUserId String

  stage Stage @relation(fields: [stageId], references: [id])
}

model Drawing {
  id             String        @id @default(cuid())
  /**
   * Nullable since the Drawings module: a drawing can be delivered against a request
   * that names no project (a generic layout, a template, a pre-order GA drawing).
   * `companyId` therefore carries the tenant scope that used to come via `order`.
   */
  orderId        String?
  companyId      String
  /** The request this drawing was delivered against, when it came from one. */
  requestId      String?
  title          String
  discipline     String // Structural | Piping | Electrical | Layout
  revision       String // A, B, C...
  fileUrl        String
  approvalStatus DrawingStatus @default(DRAFT)
  changeNote     String?
  isCurrent      Boolean       @default(true) // re-upload same title → old rev isCurrent=false, SUPERSEDED
  uploadedById   String
  createdAt      DateTime      @default(now())

  order   Order?          @relation(fields: [orderId], references: [id])
  request DrawingRequest? @relation(fields: [requestId], references: [id])

  @@index([orderId, title])
  @@index([companyId, title])
  @@index([requestId])
}

/**
 * DRAWING REQUESTS — "please draw this for me".
 *
 * Green Ecocare's own proposal commits to "civil drawings with all details within 10
 * days from the date of the P.O.", so a drawing is a contractual deliverable with an
 * SLA, not just a file. This model is what makes that commitment trackable: who asked,
 * for what, by when, and whether it landed.
 *
 * `orderId` and `leadId` are BOTH optional and independent — a request can name a won
 * project, an enquiry still being quoted (a GA drawing that helps close the deal), or
 * neither (a generic/template drawing). Tenant scope is always `companyId`, never the
 * relation.
 */
model DrawingRequest {
  id            String               @id @default(cuid())
  companyId     String
  orderId       String? // a won project
  leadId        String? // an enquiry still being quoted
  title         String // what to draw — becomes the Drawing.title, so the revision chain keys off it
  discipline    String // Structural | Piping | Electrical | Layout | ...
  purpose       String? // what it's needed for
  notes         String?
  dueDate       DateTime? // defaults to +10 days, matching the proposal's own commitment
  priority      String               @default("NORMAL") // LOW | NORMAL | HIGH
  status        DrawingRequestStatus @default(OPEN)
  /** Set on REJECTED/CHANGES_REQUESTED — the reason the requester sent it back. */
  changeReason  String?
  assignedToId  String? // who is drawing it
  requestedById String
  closedAt      DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  order    Order?    @relation(fields: [orderId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])
  drawings Drawing[]

  @@index([companyId, status])
  @@index([companyId, requestedById])
  @@index([companyId, assignedToId])
  @@index([orderId])
  @@index([leadId])
}

/**
 * OPEN              — raised, nobody has picked it up
 * IN_PROGRESS       — someone is drawing it
 * DELIVERED         — a drawing has been uploaded, waiting on the requester
 * CHANGES_REQUESTED — sent back with a reason; the next upload becomes the next revision
 * COMPLETED         — the requester accepted it
 * CANCELLED         — withdrawn
 */
enum DrawingRequestStatus {
  OPEN
  IN_PROGRESS
  DELIVERED
  CHANGES_REQUESTED
  COMPLETED
  CANCELLED
}

model PaymentMilestone {
  id            String          @id @default(cuid())
  orderId       String
  seq           Int
  description   String // "50% Advance", "30% on equipment delivery"
  amount        Decimal         @db.Decimal(14, 2)
  dueBasis      String // DATE | STAGE_COMPLETION
  dueDate       DateTime?
  linkedStageId String?
  status        MilestoneStatus @default(UPCOMING)
  receipts      Receipt[]
  invoice       Invoice?

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Receipt {
  id          String   @id @default(cuid())
  milestoneId String
  date        DateTime
  amount      Decimal  @db.Decimal(14, 2)
  mode        String // CASH | CHEQUE | NEFT | UPI
  refNo       String?
  note        String?
  createdById String // ADMIN only

  milestone PaymentMilestone @relation(fields: [milestoneId], references: [id])

  @@index([milestoneId])
}

model Invoice {
  id           String   @id @default(cuid())
  companyId    String
  invoiceNo    String   @unique // GEC-INV-2026-###  (sequential, never reused)
  orderId      String
  milestoneId  String?  @unique
  date         DateTime
  lineItems    Json
  taxType      String // CGST_SGST | IGST (place-of-supply)
  gstBreakup   Json // {cgst, sgst, igst, rate}
  total        Decimal  @db.Decimal(14, 2)
  amountWords  String
  pdfUrl         String
  isCreditNote   Boolean  @default(false)
  status         String   @default("ISSUED") // DRAFT | ISSUED — A5 auto-drafts get a real number on issue
  creditNoteOfId String? @unique // the original invoice this credit note reverses — @unique enforces at most one CN per invoice

  milestone    PaymentMilestone? @relation(fields: [milestoneId], references: [id])
  creditNoteOf Invoice?          @relation("CreditNote", fields: [creditNoteOfId], references: [id])
  creditNote   Invoice?          @relation("CreditNote")

  @@index([companyId])
  @@index([orderId])
}

model Item {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  category      String // Plumbing | Civil | PumpsMotors | Blowers | Electrical | MediaConsumables | Tools
  specification String?
  unit          String // nos | m | kg | bag
  reorderLevel  Decimal  @default(0) @db.Decimal(12, 3)
  purchasePrice Decimal? @db.Decimal(12, 2) // *** ADMIN-ONLY — strip for EMPLOYEE ***

  // Vendor catalog reference (from the vendor's own price list, e.g. MATERIAL LIST.xlsx) —
  // NOT the real freight/loading charged on any actual PO, which varies by vendor/qty/site
  // and lives on PurchaseOrder.freight/loadingCharges + itemLedger's poHistory instead.
  // *** ADMIN-ONLY — strip for EMPLOYEE ***
  catalogFreight        Decimal? @db.Decimal(12, 2)
  catalogLoadingCharges Decimal? @db.Decimal(12, 2)

  vendorPrices VendorPrice[]
  movements    StockMovement[]

  @@index([companyId, category])
}

model Vendor {
  id         String          @id @default(cuid())
  companyId  String
  name       String
  categories String[] // filters vendor list per PO item category
  contact    String?
  phone      String
  address    String?
  gstin      String?
  terms      String?
  rating     Int?
  pos        PurchaseOrder[]

  @@index([companyId])
}

model VendorPrice {
  id       String   @id @default(cuid())
  itemId   String
  vendorId String
  rate     Decimal  @db.Decimal(12, 2)
  poId     String
  date     DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId, vendorId])
}

model Location {
  id        String       @id @default(cuid())
  companyId String
  type      LocationType
  name      String // "Main Warehouse", "Warehouse 2", or site = orderNo
  orderId   String?      @unique // set when type=SITE

  order Order? @relation(fields: [orderId], references: [id])

  @@index([companyId, type])
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  companyId      String
  poNo           String   @unique // GEC-PO-2026-###
  vendorId       String
  destinationId  String // Location (warehouse OR site)
  expectedDate   DateTime
  status         POStatus @default(DRAFT)
  items          Json // [{itemId, qty, rate}]  rate ADMIN-ONLY
  totalValue     Decimal  @db.Decimal(14, 2) // ADMIN-ONLY — Σ items only (qty × rate), freight/loading excluded (see freight/loadingCharges)
  freight        Decimal? @db.Decimal(12, 2) // ADMIN-ONLY — vendor freight charge, shown on the PO print total, not folded into totalValue
  loadingCharges Decimal? @db.Decimal(12, 2) // ADMIN-ONLY — vendor loading/unloading charge, same treatment as freight
  pdfUrl         String?
  grns           GRN[]
  createdById    String
  createdAt      DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([companyId, status])
}

model GRN {
  id           String   @id @default(cuid())
  grnNo        String?  @unique // GEC-GRN-2026-001 (nullable: pre-numbering GRNs stay null)
  poId         String
  date         DateTime @default(now())
  items        Json // [{itemId, receivedQty}]  partial allowed
  challanUrl   String? // delivery challan photo
  receivedById String

  po PurchaseOrder @relation(fields: [poId], references: [id])

  @@index([poId])
}

// IMMUTABLE LEDGER — never update/delete; balances are derived.
model StockMovement {
  id             String       @id @default(cuid())
  companyId      String
  itemId         String
  qty            Decimal      @db.Decimal(12, 3)
  type           MovementType
  fromLocationId String?
  toLocationId   String?
  refDocType     String? // GRN | TRANSFER | ERECTION | AUDIT
  refDocId       String?
  valueAtCost    Decimal?     @db.Decimal(14, 2) // ADMIN-ONLY (consumption → project actuals)
  note           String?
  createdById    String
  createdAt      DateTime     @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId, toLocationId])
  @@index([itemId, fromLocationId])
}

model MaterialRequest {
  id            String   @id @default(cuid())
  orderId       String
  items         Json // [{itemId, qty}] — NO prices ever
  status        String   @default("PENDING") // PENDING | CONVERTED_PO | TRANSFERRED | REJECTED
  requestedById String
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model ErectionEntry {
  id           String       @id @default(cuid())
  orderId      String // ALWAYS starts by choosing project
  type         ErectionType
  date         DateTime
  description  String // "tank shuttering — 4 masons, 6 helpers"
  gangOrShop   String? // contractor name / shop name
  amount       Decimal      @db.Decimal(14, 2)
  paymentMode  String?
  billImages   Json // [{url}] — MANDATORY for SITE_PURCHASE
  status       EntryStatus  @default(PENDING)
  adminNote    String?
  createdById  String
  reviewedById String?
  aiExtract    Json?   // A10 Claude-vision bill extract {amount,shopName,date,items,confidence}
  aiMatch      String? // PASS | MISMATCH | UNREADABLE
  createdAt    DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
}

model Budget {
  id          String  @id @default(cuid())
  orderId     String  @unique
  baseAmount  Decimal @db.Decimal(14, 2) // seeded from winning version estimatedCost
  adjustments Json // [{amount, reason, byUserId, date}]

  order Order @relation(fields: [orderId], references: [id])
}

model Document {
  id           String   @id @default(cuid())
  orderId      String
  title        String
  fileUrl      String
  kind         String? // Contract | Permit | Photo | Report | Other
  uploadedById String
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  action    String // CREATE | UPDATE | DELETE | VIEW_PRICE | APPROVE | EXPORT
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([companyId, createdAt])
}

// Sequential document counters (Invoice/Order/Proposal/PO). One row per (companyId, kind, year).
// Numbers are never reused — allocation happens inside a transaction with a row lock.
model NumberSequence {
  id        String @id @default(cuid())
  companyId String
  kind      String // INVOICE | ORDER | PROPOSAL | PO
  year      Int
  lastValue Int    @default(0)

  @@unique([companyId, kind, year])
}

// ---------- AMC / O&M lifecycle (post-handover) ----------

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ServiceFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum VisitStatus {
  UPCOMING
  DUE
  DONE
  MISSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ServiceContract {
  id            String           @id @default(cuid())
  companyId     String
  contractNo    String           @unique // GEC-AMC-2026-001
  orderId       String? // the plant this AMC covers
  clientName    String
  siteAddress   String
  startDate     DateTime
  endDate       DateTime
  annualValue   Decimal          @db.Decimal(14, 2) // *** ADMIN-ONLY — strip for EMPLOYEE ***
  frequency     ServiceFrequency @default(QUARTERLY)
  visitsPerYear Int              @default(4)
  scope         Json // {mechanical, electrical, chemical, consumablesIncluded, exclusions}
  status        ContractStatus   @default(ACTIVE)
  renewedFromId String? // the prior contract this one renews (renewal chain)
  createdById   String
  createdAt     DateTime         @default(now())

  order          Order?             @relation(fields: [orderId], references: [id])
  visits         MaintenanceVisit[]
  tickets        ServiceTicket[]
  communications Communication[]
  renewedFrom    ServiceContract?   @relation("Renewal", fields: [renewedFromId], references: [id])
  renewals       ServiceContract[]  @relation("Renewal")

  @@index([companyId, status])
  @@index([endDate])
  @@index([renewedFromId])
}

model MaintenanceVisit {
  id            String      @id @default(cuid())
  contractId    String
  seq           Int
  scheduledDate DateTime
  actualDate    DateTime?
  status        VisitStatus @default(UPCOMING)
  checklist     Json? // [{item, ok, note}]
  readings      Json? // {ph, do, flowKld, blowerHours, ...}
  notes         String?
  photos        Json? // [{url}]
  technicianId  String?
  lat           Float?
  lng           Float?
  createdAt     DateTime    @default(now())

  contract ServiceContract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@index([scheduledDate, status])
}

model ServiceTicket {
  id           String         @id @default(cuid())
  companyId    String
  ticketNo     String         @unique // GEC-TKT-2026-001
  contractId   String?
  orderId      String?
  title        String
  description  String
  raisedBy     String // client name / staff
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  assignedToId String?
  slaDueDate   DateTime?
  resolution   String?
  createdById  String
  createdAt    DateTime       @default(now())
  closedAt     DateTime?

  contract ServiceContract? @relation(fields: [contractId], references: [id])

  @@index([companyId, status])
  @@index([slaDueDate])
}

/// Tenant registry. companyId on every model refers to Company.id.
model Company {
  id        String   @id
  name      String
  gstin     String?
  stateCode String   @default("33")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Editable company details (Settings). Null = fall back to env default.
  address       String?
  logoUrl       String?
  invoicePrefix String?
  orderPrefix   String?
  proposalPrefix String?
  poPrefix      String?

  // Letterhead (Settings → print-shell.tsx header/footer on every PDF).
  tagline  String?
  phone    String?
  email    String?
  website  String?
  branches String[] @default([])

  // Standard proposal T&Cs (Settings) — seeds ProposalVersion.terms on every new
  // proposal; still freely editable per-proposal afterward (not locked to this).
  standardTermsTemplate String? @db.Text

  // Project Report boilerplate (Settings → Proposal document). These are the sections
  // of the client's real Project Proposal that are word-for-word identical across
  // every sample regardless of technology, so they belong to the COMPANY, not to a
  // proposal. Same convention as standardTermsTemplate: null = fall back to the
  // DEFAULT_* constant, so a fresh company gets the real document with no data entry.
  docIntroduction     String? @db.Text // §4 "Introduction" — who Green Ecocare is
  docPlantAbout       String? @db.Text // §5 what an STP is
  docCivilDesign      String? @db.Text // §7 Civil Design
  docMepDesign        String? @db.Text // §8 MEP Design intro
  docTaxesDuties      String? @db.Text // §10.2 Taxes & Duties
  docSupplyErection   String? @db.Text // §11 Supply, Erection, Commissioning & Takeover
  docWarranty         String? @db.Text // §12 Warranty Details
  docScopeGreenEcocare String? @db.Text // §13 Scope of work by Green Ecocare
  docScopeClient      String? @db.Text // §14 Scope of work for the Client
  docPointsToNote     String? @db.Text // §14 "POINTS TO BE NOTED"
  docSignatoryName    String? // cover-letter signature block
  docSignatoryTitle   String?
  docSignatoryPhone   String?
  /** §15 Recent Completed Projects — [{client, project, plant, technology, capacity}] */
  docRecentProjects   Json?

  // Editable thresholds (Settings) — read at automation runtime, no redeploy.
  minMarginPct      Decimal? @db.Decimal(5, 4) // e.g. 0.1000 = 10%
  autoApproveLimit  Int? // ₹ ceiling for erection auto-approve (0/null = all manual)
  budgetAlertPct    Int[] // e.g. [70, 90, 100]
  lowStockMultiplier Decimal? @db.Decimal(5, 2) // reorder-level buffer (1.00 = at level)
}

// ─── Automation Engine (AUTOMATION-ENGINE-SPEC-v1.0) ───────────────────────────

model AutomationLog {
  id        String   @id @default(cuid())
  companyId String
  name      String // "payment-reminders"
  dedupeKey String // e.g. "A4:milestone:xyz:offset-3"
  channel   String // WHATSAPP | PUSH | EMAIL | INAPP | NONE
  target    String? // phone / userId
  payload   Json?
  status    String // SENT | FAILED | SKIPPED | DRY_RUN
  error     String?
  createdAt DateTime @default(now())

  @@unique([dedupeKey])
  @@index([companyId, name, createdAt])
}

model AutomationSetting {
  id        String @id @default(cuid())
  companyId String
  key       String // "A4.enabled", "A4.escalationDays", "A11.enabled"...
  value     Json

  @@unique([companyId, key])
}

/** Runtime-editable integration config (API keys, endpoints) an admin pastes in Settings →
 *  Integrations. Overrides the matching .env value at request time so keys can be rotated
 *  WITHOUT a redeploy/restart. `valueEnc` is AES-256-GCM encrypted at rest (key derived from
 *  SESSION_SECRET — which is deliberately env-only, never storable here). Auth/session/storage
 *  roots stay env-only; only the per-call integration keys live here. */
model ConfigSetting {
  id          String   @id @default(cuid())
  companyId   String
  key         String // managed allowlist only: "GROQ_API_KEY", "WHATSAPP_TOKEN"...
  valueEnc    String // AES-256-GCM ciphertext (iv|tag|ct, base64) — never plaintext
  updatedById String
  updatedAt   DateTime @updatedAt

  @@unique([companyId, key])
}

model AutomationTask {
  id         String    @id @default(cuid())
  companyId  String
  type       String // STALE_PROPOSAL | STAGE_DELAY | BUDGET_OVERRUN | ...
  title      String
  entity     String
  entityId   String
  assigneeId String
  status     String    @default("OPEN") // OPEN | DONE | DISMISSED
  note       String?
  dueDate    DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId, assigneeId, status])
  @@index([companyId, type, entityId])
}

/** Web Push subscriptions — one row per (user, browser/device). A user with the app
 *  open on 2 devices has 2 rows; both get notified. Endpoint is the push service's
 *  unique per-registration URL (doubles as the natural upsert key). Pruned when the
 *  push service reports it gone (410/404) — see src/lib/push.ts. */
model PushSubscription {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([companyId, userId])
}

/** A14 · Win/loss learning loop — a snapshot written when a proposal is decided, used as
 *  few-shot context for the AI generator + quarterly win-rate analysis. */
model ProposalOutcome {
  id          String   @id @default(cuid())
  companyId   String
  proposalId  String   @unique
  outcome     String // WON | LOST
  reason      String?
  capacityKLD Float
  plantType   String
  technology  String
  grandTotal  Decimal  @db.Decimal(14, 2)
  marginPct   Float?
  boqSnapshot Json?
  decidedAt   DateTime @default(now())

  @@index([companyId, plantType])
  @@index([companyId, outcome])
}
